{
    "model_name": "FinalCrossModalASDNetwork",
    "task": "Binary ASD classification",
    "output_classes": {
        "0": "NON-ASD",
        "1": "ASD"
    },
    "input_dimensions": {
        "genetic": 32,
        "behavioral": 32,
        "environmental": 32
    },
    "architecture": {
        "genetic_branch": "32 -> 64 -> 32",
        "behavioral_branch": "32 -> 64 -> 32",
        "environmental_branch": "32 -> 64 -> 32",
        "cross_modal_features": [
            "G",
            "B",
            "E",
            "|G-B|",
            "|G-E|",
            "|B-E|",
            "G*B",
            "G*E",
            "B*E"
        ],
        "fusion_input_dimension": 288,
        "joint_representation": "288 -> 128 -> 64 -> 32",
        "classifier": "32 -> 1",
        "activation": "sigmoid"
    },
    "training": {
        "optimizer": "Adam",
        "learning_rate": 0.001,
